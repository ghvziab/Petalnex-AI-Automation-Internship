    {
      "parameters": {
        "jsCode": "function titlecase(name) {\n  return name.toLowerCase().replace(/\\b\\w/g, char => char.toUpperCase());\n}\nfunction emailcheck(email) {\n  const freeDomains = [\n    'gmail.com', \n    'yahoo.com', \n    'outlook.com', \n    'hotmail.com', \n    'aol.com', \n    'icloud.com',\n    'live.com'\n  ];\n\n  const domain = email.split('@')[1].toLowerCase();\n\n  if (freeDomains.includes(domain)) {return false;} \n  else {return true;}\n}\nfor (const item of $input.all()) {\n  \n  let lead = item.json;\n  \n  lead.name = titlecase(lead.name);\n  lead.email = lead.email.toLowerCase();\n  lead.score = 0;\n  \n  if (lead.budget >= 10000){lead.score += 45;}\n  else if(lead.budget >= 5000){lead.score += 25;}\n  else if(lead.budget >= 1000){lead.score += 15;}\n  else if(lead.budget <= 1000){lead.score += 5;}\n\n  if(emailcheck(lead.email) == true){lead.score += 15;}\n  else if(emailcheck(lead.email) == false){lead.score += 5;}\n  \n  if(lead.company != null){lead.score += 15;}  \n\n  if(lead.score >= 70 ){lead.priority = \"HIGH\"}\n  else if(lead.score >= 40 ){lead.priority = \"MEDIUM\"}\n  else if(lead.score < 40 ){lead.priority = \"LOW\"}\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        -256
      ],
      "id": "bdb47eb7-7c5a-4c6c-b78b-3c0cac050e4b",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const cleanItems = [];\n\nfor (const item of $input.all()) {\n  const payload = item.json.body;\n\n  if (Array.isArray(payload)) {\n    for (const record of payload) {\n      cleanItems.push({ json: record }); \n    }\n  } \n  else if (payload && typeof payload === 'object') {\n    cleanItems.push({ json: payload });\n  }\n}\n\nreturn cleanItems;"
      },
