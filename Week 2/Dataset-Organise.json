      "parameters": {
        "jsCode": "function titlecase (name){\n  return name.toLowerCase().replace(/\\b\\w/g, char => char.toUpperCase())\n}\nfor (const item of $input.all()) {\n  let cand = item.json;\n  cand.Name = titlecase(cand.Name);\n  cand.Email = cand.Email.toLowerCase();\n  cand.Grade = \"\";\n}\nreturn $input.all().map(item => {\n  let cand = item.json;\n  if(Number(cand.Score) >= 90){cand.Grade = \"A\"}\n  else if(Number(cand.Score) >= 80){cand.Grade = \"B\"}\n  else if(Number(cand.Score) >= 70){cand.Grade = \"C\"}\n  else if(Number(cand.Score) >= 60){cand.Grade = \"D\"}\n  else{cand.Grade = \"F\"}\n  return item;\n} ).filter(item => {return item.json.Grade <= \"B\"});"
      },
