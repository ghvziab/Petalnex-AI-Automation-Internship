    {
      "parameters": {
        "jsCode": "const req_exp = 3.0;\nconst req_skill = [\"Python\", \"TensorFlow\", \"PyTorch\"]; \nconst req_deg = [\"MS Artificial Intelligence\", \"BS Data Science\", \"MS Software Engineering\"];\n\nfor (const item of $input.all()) {\n    let candidate = item.json;\n    \n    candidate.Status = \"Rejected\"; \n    let cand_skill = [];\n    cand_skill = candidate.Skills.split(',').map(skill => skill.trim());\n    \n    let skill_match = req_skill.filter(skill => cand_skill.includes(skill)).length;\n    \n    if (candidate.Experience >= req_exp && req_deg.includes(candidate.Degree) && skill_match >= 2) {\n        candidate.Status = \"Shortlisted\";\n    } \n    else if (skill_match >= 1 && candidate.Experience >= 0) {\n        candidate.Status = \"Review Required\";\n    }\n  delete candidate.row_number;\n}\n\nreturn $input.all();"
      },
