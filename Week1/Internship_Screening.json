        -560
      ],
      "typeVersion": 1,
      "id": "0096c92c-de49-4fa5-98c9-405b6a57eee4",
      "name": "Sticky Note"
    },
    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  const req_skills = [\"Java\", \"Python\", \"Git\", \"C++\",\"Go\", \"AWS\"];\n  const cand_skill = item.json.Skills.split(\",\").map(skill => skill.trim());\n  const match = cand_skill.filter(skill => req_skills.includes(skill));\n  item.json.skillmatch = match.length;\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        64
      ],
