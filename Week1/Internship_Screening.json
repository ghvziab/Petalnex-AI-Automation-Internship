      "parameters": {
        "content": "Eligibility Criteria:\n-CGPA>=2.7\n-Semester>=5\nShortlist Criteria:\n-CGPA>=3 + 3<= relevant skills\nConsideration Criteria:\n-2 relevant skills",
        "height": 208
      },
